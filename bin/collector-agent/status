#!/usr/bin/env sh
set -eu

BASE_DIR=${BASE_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}
PID_FILE=${PID_FILE:-"$BASE_DIR/run/collector-agent.pid"}

if [ ! -f "$PID_FILE" ]; then
  echo "collector-agent is stopped"
  exit 3
fi

PID=$(cat "$PID_FILE")
if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
  echo "collector-agent is running: pid=$PID"
  exit 0
fi

echo "collector-agent is stopped: stale pid file"
exit 1
