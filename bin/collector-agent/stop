#!/usr/bin/env sh
set -eu

BASE_DIR=${BASE_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}
PID_FILE=${PID_FILE:-"$BASE_DIR/run/collector-agent.pid"}

if [ ! -f "$PID_FILE" ]; then
  echo "collector-agent is not running: pid file not found"
  exit 0
fi

PID=$(cat "$PID_FILE")
if [ -z "$PID" ] || ! kill -0 "$PID" 2>/dev/null; then
  rm -f "$PID_FILE"
  echo "collector-agent is not running: stale pid file removed"
  exit 0
fi

kill "$PID"

i=0
while kill -0 "$PID" 2>/dev/null; do
  i=$((i + 1))
  if [ "$i" -ge 30 ]; then
    echo "collector-agent did not stop within 30s: pid=$PID"
    exit 1
  fi
  sleep 1
done

rm -f "$PID_FILE"
echo "collector-agent stopped"

